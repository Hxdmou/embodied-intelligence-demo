# 复制本文件为 .env 并填入真实值；.env 已被 .gitignore 忽略，永不入库
# 纯离线演示（本地 Ollama + 本地嵌入模型）无需任何 Key，以下均为可选增强项

# 高德地图 Keys（可选）
AMAP_WEB_KEY=your_amap_web_key
AMAP_JS_KEY=your_amap_js_key
AMAP_JS_SECURITY_CODE=your_amap_js_security_code

# DashScope Keys（可选）
DASHSCOPE_API_KEY=your_dashscope_key_1
DASHSCOPE_API_KEY_2=your_dashscope_key_2
DASHSCOPE_API_KEY_3=your_dashscope_key_3
DASHSCOPE_API_KEY_4=your_dashscope_key_4
