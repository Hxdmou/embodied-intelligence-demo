# ============================================================
# EmbodiedSim-Framework 环境变量模板
# 使用方法：复制本文件为 .env 后填入对应值
# 所有值均为示例，可按需修改
# ============================================================

# ---------- 仿真环境配置 ----------
SIMULATION_MODE=gui                # gui / direct / share_memory
SIMULATION_GRAVITY=-9.81           # 重力加速度
SIMULATION_TIMESTEP=0.002          # 仿真步长（秒）
SIMULATION_RENDER_WIDTH=1280       # 渲染宽度
SIMULATION_RENDER_HEIGHT=720       # 渲染高度

# ---------- 机器人默认配置 ----------
DEFAULT_ROBOT_TYPE=panda           # panda / kuka_iiwa（示例类型）
DEFAULT_END_EFFECTOR_INDEX=11      # 末端执行器关节索引
DEFAULT_CONTROL_MODE=position      # position / velocity / torque

# ---------- 部署配置 ----------
DEPLOY_LEVEL=test                  # test / pre / prod
DEPLOY_TIMEOUT_S=3600              # 部署超时（秒）
DEPLOY_AUTO_RECOVERY=true          # 故障自动恢复

# ---------- 通信配置（可选） ----------
# COMM_MODE=tcp                    # tcp / udp / can / ethercat / ros
# COMM_HOST=127.0.0.1
# COMM_PORT=5000

# ---------- 大模型接入配置（可选） ----------
# LLM_PROVIDER=qianwen
# LLM_MODEL_NAME=qwen-plus
# LLM_TEMPERATURE=0.7
# DASHSCOPE_API_KEY=YOUR_DASHSCOPE_API_KEY
# OPENAI_API_KEY=YOUR_OPENAI_API_KEY
# OPENAI_API_BASE=https://api.openai.com/v1

# ---------- 日志与安全 ----------
LOG_LEVEL=INFO                     # DEBUG / INFO / WARNING / ERROR
LOG_ENABLE_FILE=true               # 文件日志开关
SAFETY_EMERGENCY_STOP_ENABLED=true # 紧急停止启用
SAFETY_COLLISION_THRESHOLD=0.05    # 碰撞检测距离阈值（米）
